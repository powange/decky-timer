{
  "name": "decky-timer",
  "version": "0.7.0",
  "description": "Decky Loader plugin: named timers shown as an in-game overlay on the Steam Deck",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "package": "rm -rf target/decky-timer && mkdir -p target/decky-timer && cp -r dist overlay main.py plugin.json package.json LICENSE README.md target/decky-timer/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powange/decky-timer.git"
  },
  "keywords": ["decky", "plugin", "steam-deck", "timer", "overlay"],
  "author": "powange",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
